# Copie este arquivo para .env (nunca faça commit do .env real)
SPRING_PROFILES_ACTIVE=dev

# Banco de dados PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=duolingo
POSTGRES_USER=duolingo
POSTGRES_PASSWORD=substitua_por_senha_forte

# Segurança e Autenticação (Obrigatórios em produção)
# Gere com: openssl rand -base64 48
JWT_SECRET=substitua_por_chave_jwt_aleatoria_com_pelo_menos_32_caracteres
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
APP_ADMIN_EMAILS=admin@duolingo.com
APP_ADMIN_INITIAL_PASSWORD=substitua_por_senha_admin_com_12_ou_mais_caracteres
SESSION_COOKIE_SECURE=false

# Provedor de IA (Exclusivo do Backend - Nunca exponha no Flutter)
AI_API_KEY=
AI_PROVIDER_URL=https://generativelanguage.googleapis.com/v1beta/models
AI_MODEL=gemini-2.5-flash

# Configurações de E-mail (SMTP para recuperação de senha)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS=true
# Em produção ou usando Gmail, o remetente deve coincidir com a conta autenticada
APP_MAIL_FROM=duolinfo.cefet@gmail.com
# Host e porta do frontend para onde o link do e-mail vai apontar
FRONTEND_PROTOCOL=http
FRONTEND_HOST=localhost
FRONTEND_PORT=5500
APP_FRONTEND_URL=http://localhost:5500
